#!/bin/sh
set -eu

supervisor_directory="${HERDR_SUPERVISOR_DIRECTORY:-/app}"
supervisor_extension="/opt/herdr-supervisor/container/supervisor-extension.ts"
supervisor_goals="${HERDR_SUPERVISOR_GOALS:-${XDG_STATE_HOME:-/home/node/.local/state}/herdr-supervisor/goals}"
supervisor_pane_file="${supervisor_goals}/.supervisor/pane-id"

case "$supervisor_directory" in
  /*) ;;
  *)
    echo "HERDR_SUPERVISOR_DIRECTORY must be an absolute directory" >&2
    exit 2
    ;;
esac

# Herdr restores a native Pi session but not the extension argument that gave
# that session its supervisor role. Restore that role only when the marker
# written by the explicit extension's session_start hook matches this exact pane
# and native Pi session. Pi parses options on either side of its optional
# initial message; only -- ends option parsing.
explicit_supervisor=0
restore_disabled=0
session_arg=""
session_id_arg=""
parse_pi_arguments() {
  while [ "$#" -gt 0 ]; do
    argument="$1"
    shift
    case "$argument" in
      --) break ;;
      -e | --extension)
        if [ "$#" -gt 0 ]; then
          if [ "$1" = "$supervisor_extension" ]; then
            explicit_supervisor=1
          fi
          shift
        fi
        ;;
      --session)
        if [ "$#" -gt 0 ]; then
          session_arg="$1"
          shift
        fi
        ;;
      --session-id)
        if [ "$#" -gt 0 ]; then
          session_id_arg="$1"
          shift
        fi
        ;;
      --no-session | --help | -h | --version | -v)
        restore_disabled=1
        ;;
      --mode | --provider | --model | --api-key | --system-prompt | --append-system-prompt | --name | -n | --fork | --session-dir | --models | --tools | -t | --exclude-tools | -xt | --thinking | --export | --skill | --prompt-template | --theme)
        if [ "$#" -gt 0 ]; then
          shift
        fi
        ;;
      --print | -p)
        if [ "$#" -gt 0 ]; then
          case "$1" in
            @*) ;;
            ---*) shift ;;
            -*) ;;
            *) shift ;;
          esac
        fi
        ;;
      --list-models)
        restore_disabled=1
        if [ "$#" -gt 0 ]; then
          case "$1" in
            @* | -*) ;;
            *) shift ;;
          esac
        fi
        ;;
      --use-theme | --tui-mode)
        if [ "$#" -gt 0 ]; then
          case "$1" in
            -*) ;;
            *) shift ;;
          esac
        fi
        ;;
      --*=*) ;;
      --*)
        if [ "$#" -gt 0 ]; then
          case "$1" in
            @* | -*) ;;
            *) shift ;;
          esac
        fi
        ;;
    esac
  done
}

parse_pi_arguments "$@"

marker_session_matches=0
if [ -n "${HERDR_PANE_ID:-}" ] && [ -f "$supervisor_pane_file" ]; then
  marker_pane_id="$(sed -n '1p' "$supervisor_pane_file")"
  marker_session_file="$(sed -n '2p' "$supervisor_pane_file")"
  marker_session_id="$(sed -n '3p' "$supervisor_pane_file")"
  if [ "$marker_pane_id" = "$HERDR_PANE_ID" ]; then
    if [ -n "$session_arg" ]; then
      case "$session_arg" in
        */* | *\\* | *.jsonl)
          session_file="$(node -e 'console.log(require("node:path").resolve(process.argv[1], process.argv[2]))' "$supervisor_directory" "$session_arg")"
          if [ "$session_file" = "$marker_session_file" ]; then
            marker_session_matches=1
          fi
          ;;
        *)
          if [ -n "$marker_session_id" ] \
            && [ -f "$marker_session_file" ] \
            && [ "$session_arg" = "$marker_session_id" ]; then
            marker_session_matches=1
          fi
          ;;
      esac
    fi
    if [ -n "$session_id_arg" ] \
      && [ -n "$marker_session_id" ] \
      && [ -f "$marker_session_file" ] \
      && [ "$session_id_arg" = "$marker_session_id" ]; then
      marker_session_matches=1
    fi
  fi
fi

if [ "$explicit_supervisor" -eq 0 ] \
  && [ "$restore_disabled" -eq 0 ] \
  && [ -n "${HERDR_PANE_ID:-}" ] \
  && { [ -z "$session_arg" ] || [ -z "$session_id_arg" ]; } \
  && [ "$marker_session_matches" -eq 1 ]; then
  set -- -e "$supervisor_extension" "$@"
fi

cd "$supervisor_directory"
exec /usr/local/bin/pi-agent "$@"
