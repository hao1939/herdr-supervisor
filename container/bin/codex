#!/bin/sh
set -eu

previous=""
has_full_access=0
has_hook_trust=0
has_project_trust=0
has_resume_cwd=0
after_resume=0
resume_arguments=0
resume_session=""
for argument in "$@"; do
  if [ "$after_resume" -eq 1 ]; then
    if [ "$resume_arguments" -eq 0 ]; then
      resume_session=$argument
    fi
    resume_arguments=$((resume_arguments + 1))
  fi
  if [ "$argument" = "resume" ]; then
    after_resume=1
  fi
  if [ "$argument" = "--dangerously-bypass-approvals-and-sandbox" ]; then
    has_full_access=1
  fi
  if [ "$argument" = "--dangerously-bypass-hook-trust" ]; then
    has_hook_trust=1
  fi
  if { [ "$previous" = "-c" ] || [ "$previous" = "--config" ]; } &&
    case "$argument" in tui.resume_cwd=*) true ;; *) false ;; esac
  then
    has_resume_cwd=1
  fi
  if { [ "$previous" = "-c" ] || [ "$previous" = "--config" ]; } &&
    case "$argument" in projects=*|projects.*.trust_level=*) true ;; *) false ;; esac
  then
    has_project_trust=1
  fi
  case "$argument" in
    -c=tui.resume_cwd=*|--config=tui.resume_cwd=*) has_resume_cwd=1 ;;
    -c=projects=*|--config=projects=*|-c=projects.*.trust_level=*|--config=projects.*.trust_level=*) has_project_trust=1 ;;
  esac
  previous="$argument"
done

# Herdr restores a stopped worker process with `codex resume <session>`, but
# only canonical active supervision owns authority to resume its native Goal.
# Terminal and unknown sessions stay preserved at Codex's normal paused-goal
# gate. A caller-supplied prompt remains authoritative.
if [ "$after_resume" -eq 1 ] && [ "$resume_arguments" -eq 1 ]; then
  if node --input-type=module -e '
    try {
      const { loadSupervisorGoals } = await import(process.argv[1]);
      const { sameAgentSession } = await import(process.argv[2]);
      const goals = await loadSupervisorGoals();
      const session = {
        source: "herdr:codex",
        agent: "codex",
        kind: "id",
        value: process.argv[3],
      };
      const matches = goals.active.filter(({ agentSession }) => (
        sameAgentSession(agentSession, session)
      ));
      if (
        goals.errors.length
        || matches.length !== 1
        || matches[0].paneId !== process.env.HERDR_PANE_ID
      ) process.exitCode = 1;
    } catch {
      process.exitCode = 1;
    }
  ' 'file:///opt/herdr-supervisor/src/goal-registry.ts' \
    'file:///opt/herdr-supervisor/src/identity.ts' "$resume_session"
  then
    set -- "$@" "/goal resume"
  fi
fi

# Codex otherwise asks which directory to use when Herdr restores a session
# from a terminal whose current directory differs from the session's saved
# directory. Workers commonly create and enter goal-owned worktrees, so keep
# that exact session directory without waiting for a human confirmation. An
# explicit caller choice remains authoritative.
if [ "$after_resume" -eq 1 ] && [ "$has_resume_cwd" -eq 0 ]; then
  set -- -c 'tui.resume_cwd="session"' "$@"
fi

if [ "${HERDR_SUPERVISOR_CODEX_FULL_ACCESS:-0}" = "1" ]; then
  # Full-access mode is the operator's explicit choice for unattended workers.
  # Trust the pane directory too so a restored worker cannot stop at Codex's
  # interactive project-trust gate. Preserve any project map supplied by the
  # caller because a second `projects` override could replace it.
  if [ "$has_project_trust" -eq 0 ]; then
    project_directory=$(node -e 'process.stdout.write(JSON.stringify(process.cwd()))')
    set -- -c "projects={$project_directory={trust_level=\"trusted\"}}" "$@"
  fi
  if [ "$has_hook_trust" -eq 0 ]; then
    set -- --dangerously-bypass-hook-trust "$@"
  fi
  if [ "$has_full_access" -eq 0 ]; then
    set -- --dangerously-bypass-approvals-and-sandbox "$@"
  fi
fi

exec /usr/local/bin/codex-agent "$@"
