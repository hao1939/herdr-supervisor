#!/bin/sh
set -eu

# Herdr Supervisor owns the durable goal lifecycle. Keeping Codex's separate
# goal feature enabled would add a second authority and can leave a restored
# worker waiting at an interactive "resume goal" prompt.
previous=""
has_disabled_goals=0
has_full_access=0
has_hook_trust=0
has_resume_cwd=0
after_resume=0
resume_argument_count=0
for argument in "$@"; do
  if [ "$after_resume" -eq 1 ]; then
    resume_argument_count=$((resume_argument_count + 1))
  elif [ "$argument" = "resume" ]; then
    after_resume=1
  fi
  if [ "$previous" = "--disable" ] && [ "$argument" = "goals" ]; then
    has_disabled_goals=1
  fi
  if [ "$argument" = "--dangerously-bypass-approvals-and-sandbox" ]; then
    has_full_access=1
  fi
  if [ "$argument" = "--dangerously-bypass-hook-trust" ]; then
    has_hook_trust=1
  fi
  if { [ "$previous" = "-c" ] || [ "$previous" = "--config" ]; } &&
    case "$argument" in tui.resume_cwd=*) true ;; *) false ;; esac
  then
    has_resume_cwd=1
  fi
  case "$argument" in
    -c=tui.resume_cwd=*|--config=tui.resume_cwd=*) has_resume_cwd=1 ;;
  esac
  previous="$argument"
done

# Herdr restores a persisted Codex agent as `codex resume SESSION_ID`. With
# native goals disabled, add one ordinary turn so the exact session continues
# instead of reopening silently at an idle prompt. An explicit recovery may
# already provide its own goal-aware prompt after the session ID.
if [ "$after_resume" -eq 1 ] && [ "$resume_argument_count" -eq 1 ]; then
  set -- "$@" "Continue working on the current supervised goal from the existing session context. Report useful progress or the exact blocker in plain language."
fi

if [ "$has_disabled_goals" -eq 0 ]; then
  set -- --disable goals "$@"
fi

# Codex otherwise asks which directory to use when Herdr restores a session
# from a terminal whose current directory differs from the session's saved
# directory. Workers commonly create and enter goal-owned worktrees, so keep
# that exact session directory without waiting for a human confirmation. An
# explicit caller choice remains authoritative.
if [ "$after_resume" -eq 1 ] && [ "$has_resume_cwd" -eq 0 ]; then
  set -- -c 'tui.resume_cwd="session"' "$@"
fi

if [ "${HERDR_SUPERVISOR_CODEX_FULL_ACCESS:-0}" = "1" ]; then
  if [ "$has_hook_trust" -eq 0 ]; then
    set -- --dangerously-bypass-hook-trust "$@"
  fi
  if [ "$has_full_access" -eq 0 ]; then
    set -- --dangerously-bypass-approvals-and-sandbox "$@"
  fi
fi

exec /usr/local/bin/codex-agent "$@"
