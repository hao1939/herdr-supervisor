{
  "name": "herdr-supervisor",
  "version": "0.2.1",
  "private": true,
  "description": "One Pi agent that supervises existing Herdr workers against explicit goals, without adding a second task system.",
  "license": "MIT",
  "author": "Hao Yuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hao1939/herdr-supervisor.git"
  },
  "homepage": "https://github.com/hao1939/herdr-supervisor#readme",
  "bugs": {
    "url": "https://github.com/hao1939/herdr-supervisor/issues"
  },
  "keywords": [
    "herdr",
    "codex",
    "agent-supervision",
    "pi-coding-agent"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "check": "tsc --noEmit && sh -n container/container-entrypoint.sh && sh -n container/bin/codex && sh -n container/bin/pi",
    "health:quick": "npm run check && npm test",
    "health:auto": "npm run health:quick && npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typescript": "^7.0.2"
  }
}
